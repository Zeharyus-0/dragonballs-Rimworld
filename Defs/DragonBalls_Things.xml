  <ThingDef ParentName="ResourceBase">
    <defName>DB_DragonBallOne</defName>
    <label>one-star dragon ball</label>
    <description>An orange sphere the size of a fist that glows from within, with one red star set inside it. It is warm, and a little heavy. There are seven, each with a different number of stars. Gather them all, lay them together, and the Eternal Dragon answers.</description>
    <thingClass>DragonBalls.Thing_DragonBall</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>DragonBalls/Ball1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9, 0.9)</drawSize>
    </graphicData>
    <alwaysHaulable>true</alwaysHaulable>
    <stackLimit>1</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <tradeability>None</tradeability>
    <statBases>
      <MarketValue>50</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <Beauty>20</Beauty>
    </statBases>
    <thingCategories><li>DB_DragonBalls</li></thingCategories>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(255,170,60,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="DragonBalls.BallExt"><stars>1</stars></li>
    </modExtensions>
  </ThingDef>
