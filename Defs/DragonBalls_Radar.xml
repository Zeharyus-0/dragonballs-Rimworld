<Defs>
  <!-- generated by Source/gen_dragonballs.py: do not edit by hand -->
  <ResearchProjectDef>
    <defName>DB_RadarResearch</defName>
    <label>dragon radar</label>
    <description>Build a handheld radar that picks up the faint warmth of a Dragon Ball from far away. With one in your colony, you will learn where the factions keep the balls they took.</description>
    <baseCost>900</baseCost>
    <techLevel>Industrial</techLevel>
    <researchViewX>4.00</researchViewX>
    <researchViewY>4.50</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>DB_EncyclopediaResearch</defName>
    <label>dragon ball encyclopedia</label>
    <description>Gather everything the radar tells you into one storybook. Adds an Encyclopedia button to the bottom bar: which faction holds which ball, and in which base. It only shows what you have found, and it needs a radar to be of any use.</description>
    <baseCost>700</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>DB_RadarResearch</li>
    </prerequisites>
    <researchViewX>5.00</researchViewX>
    <researchViewY>4.50</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>DB_RadarPrecisionResearch</defName>
    <label>dragon radar precision</label>
    <description>Without this, the radar shows a signal and the faction that holds it, but only roughly: the marker sits on one of that faction's bases, and it may be the wrong one. This research lets the radar show the exact base. It also helps the Encyclopedia.</description>
    <baseCost>1200</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>DB_RadarResearch</li>
    </prerequisites>
    <researchViewX>5.00</researchViewX>
    <researchViewY>5.50</researchViewY>
  </ResearchProjectDef>

  <ThingDef ParentName="ResourceBase">
    <defName>DB_DragonRadar</defName>
    <label>dragon radar</label>
    <description>A handheld radar with a round green screen. It listens for the faint warmth of a Dragon Ball. While you own one, it sweeps for the balls the factions have taken and marks their bases on the world map. It does nothing for a ball lying free on a map.</description>
    <graphicData>
      <texPath>DragonBalls/Radar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.8, 0.8)</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <tradeability>Sellable</tradeability>
    <techLevel>Industrial</techLevel>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>true</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>450</MarketValue>
      <Mass>0.6</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Gold>5</Gold>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisite>DB_RadarResearch</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>2100</displayPriority>
    </recipeMaker>
  </ThingDef>

  <MainButtonDef>
    <defName>DB_Encyclopedia</defName>
    <label>encyclopedia</label>
    <description>The Dragon Ball encyclopedia: which faction holds which ball, and where.</description>
    <workerClass>DragonBalls.MainButtonWorker_Encyclopedia</workerClass>
    <tabWindowClass>DragonBalls.MainTabWindow_Encyclopedia</tabWindowClass>
    <order>62</order>
    <validWithoutMap>false</validWithoutMap>
  </MainButtonDef>

  <WorldObjectDef>
    <defName>DB_BallSignal</defName>
    <label>dragon ball signal</label>
    <description>The radar picked up the warmth of a Dragon Ball here.</description>
    <worldObjectClass>DragonBalls.WorldObject_BallSignal</worldObjectClass>
    <texture>DragonBalls/Signal</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>DragonBalls/Signal</expandingIconTexture>
    <expandingIconPriority>95</expandingIconPriority>
    <expandMore>true</expandMore>
    <selectable>false</selectable>
    <saved>false</saved>
  </WorldObjectDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DB_PhoenixCocoon</defName>
    <label>phoenix</label>
    <description>A phoenix of golden flame hangs over a fallen immortal and remakes them in its fire over six hours. Nothing can touch what is inside. When the body is whole, you choose where they rise.</description>
    <thingClass>DragonBalls.Building_PhoenixCocoon</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>DragonBalls/Clear</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <size>(1, 1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <tradeability>None</tradeability>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <LetterDef>
    <defName>DB_RebirthLetter</defName>
    <letterClass>DragonBalls.ChoiceLetter_Rebirth</letterClass>
    <color>(255, 190, 90)</color>
    <flashColor>(255, 190, 90)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
  </LetterDef>

  <LetterDef>
    <defName>DB_WarLetter</defName>
    <letterClass>DragonBalls.ChoiceLetter_War</letterClass>
    <color>(255, 190, 90)</color>
    <flashColor>(255, 190, 90)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_BadUrgent</arriveSound>
  </LetterDef>

  <LetterDef>
    <defName>DB_DealLetter</defName>
    <letterClass>DragonBalls.ChoiceLetter_Deal</letterClass>
    <color>(255, 190, 90)</color>
    <flashColor>(255, 190, 90)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
  </LetterDef>

  <HediffDef>
    <defName>DB_Revived</defName>
    <label>returned from the dead</label>
    <description>A Dragon Ball brought this body back once. The Eternal Dragon will not do it a second time.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.9, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>

  <HediffDef>
    <defName>DB_Giant</defName>
    <label>towering</label>
    <description>Blessed by a wish to stand head and shoulders above everyone else: it hits very hard, has thick natural armor, and can never be recruited.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.5, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <painFactor>0.3</painFactor>
        <statOffsets>
          <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
          <ArmorRating_Heat>0.4</ArmorRating_Heat>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>2.2</MeleeDamageFactor>
          <IncomingDamageFactor>0.45</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
