  <ResearchProjectDef>
    <defName>DB_EncyclopediaResearch</defName>
    <label>dragon ball encyclopedia</label>
    <description>Gather everything the radar tells you into one storybook. Adds an Encyclopedia button to the bottom bar: which faction holds which ball, and in which base. It only shows what you have found, and it needs a radar to be of any use.</description>
    <baseCost>700</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>DB_RadarResearch</li>
    </prerequisites>
